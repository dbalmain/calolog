{
  "name": "calolog",
  "version": "1.0.0",
  "description": "A command-line tool for tracking food intake and analyzing nutritional data",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "npm run dev -w packages/cli",
    "import-usda": "npm run start -w packages/importer",
    "test": "npm run test --workspaces --if-present",
    "cli": "node packages/cli/dist/index.js"
  },
  "keywords": [
    "nutrition",
    "food-tracking",
    "cli",
    "health",
    "fitness"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
